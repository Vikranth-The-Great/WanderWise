<svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300">
  <defs>
    <linearGradient id="coFounderGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F97316" />
      <stop offset="100%" stop-color="#FB923C" />
    </linearGradient>
  </defs>
  
  <!-- Background circle -->
  <circle cx="150" cy="150" r="140" fill="url(#coFounderGradient)" />
  
  <!-- Person silhouette -->
  <circle cx="150" cy="120" r="40" fill="white" opacity="0.9" />
  <ellipse cx="150" cy="220" rx="60" ry="80" fill="white" opacity="0.9" />
  
  <!-- Professional touch -->
  <rect x="130" y="180" width="40" height="60" fill="#1E3A8A" opacity="0.8" rx="5" />
  
  <!-- Text overlay -->
  <text x="150" y="280" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="white">Co-Founder</text>
</svg>